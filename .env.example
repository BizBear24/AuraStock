# Public Supabase project settings (safe for the browser; protected by RLS).
# Never put the service-role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Drive backups. A Google OAuth "Web application" client ID (public, not a secret).
# Leave empty to hide Drive features. See DEVELOPMENT.md > Google Drive setup.
VITE_GOOGLE_CLIENT_ID=
